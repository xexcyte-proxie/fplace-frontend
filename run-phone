#!/usr/bin/env bash
# Test on phone: server only — open http://<your-mac-ip>:8080 in mobile Chrome.
# Uses --release (much smaller/faster on phone). Hot reload does not work — refresh after changes.
set -e
cd "$(dirname "$0")"
IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "YOUR_MAC_IP")
echo "→ Stopping anything on port 8080 (if present)…"
lsof -ti:8080 | xargs kill -9 2>/dev/null || true
echo ""
echo "  Phone URL:  http://${IP}:8080"
echo "  Must include http:// and use this Mac's Wi‑Fi IP (often 192.168.x.x)."
echo "  First load: 30–90s (Flutter + Mappedin CDN). Same Wi‑Fi as this Mac."
echo "  Ignore 'No client connected' — hard-refresh the phone browser after code changes."
echo ""
flutter run -d web-server --release --web-hostname 0.0.0.0 --web-port 8080 "$@"
