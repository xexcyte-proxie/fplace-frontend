# Default: never cache HTML shell / navigation responses.
# Netlify matches headers on the *request* path, so SPA routes
# like `/settings` must not inherit a long-lived cache.
/*
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinted Vite bundles - safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable
