VITE_MAPPEDIN_MAP_ID=65c0ff7430b94e3fabd5bb8c
# Optional local testing override. When both are set, the client loads the map
# with this key/secret instead of the backend Mappedin token. Do not commit secrets.
# VITE_MAPPEDIN_KEY=
# VITE_MAPPEDIN_SECRET=
# Mappedin API key/secret are not required in production; tokens come from:
#   guests: POST /api/users/guest/ → mappedin.token
#   users:  GET /api/maps/token/
# Leave unset for local dev - Vite proxies /api → the AWS ALB (avoids CORS).
# Netlify production uses the same /api proxy via netlify.toml.
# Only set this if the backend allows your origin via CORS:
# VITE_API_URL=http://fplaces-alb-1964416382.us-east-1.elb.amazonaws.com
# WebSocket origin for live venue feed/heatmap.
# Local HTTPS (iPhone LAN): leave unset. The app uses same-origin wss and Vite
# proxies /ws to the ALB. iOS may still stall on the self-signed cert; the
# client aborts a hung handshake after 8s and keeps retrying.
# To bypass the Vite proxy on HTTP pages only:
# VITE_WS_URL=ws://fplaces-alb-1964416382.us-east-1.elb.amazonaws.com
# Netlify production: set automatically via netlify.toml [build.environment].
# HTTPS pages cannot open ws:// (mixed content) until the ALB has TLS / wss.
# Google Sign-In (Web client ID from Google Cloud Console):
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# VITE_AR_URL=https://fplaces-test.netlify.app/
# Keep unset for same-origin /ar/ (recommended): iframe stays on your domain,
# direct JS bridge + postMessage work without cross-origin limits.
# Dev default (no .env): Vite serves ../ar-nav at /ar/
# Optional: force a live position source.
# Leave unset - the app auto-picks Indoor Atlas (if keyed) → BLE beacons
# (if Web Bluetooth + venue matrix) → Apple Indoor (iPhone/iPad) → GPS.
# VITE_POSITION_SOURCE=gps
# VITE_POSITION_SOURCE=apple_indoor
# VITE_POSITION_SOURCE=indoor_atlas
# VITE_POSITION_SOURCE=ble_beacon
# VITE_INDOOR_ATLAS_API_KEY=
# VITE_INDOOR_ATLAS_API_SECRET=
# VITE_BLE_RSSI_THRESHOLD_DBM=-70
# VITE_BLE_SCAN_INTERVAL_MS=500
# VITE_DEBUG_POSITION_HUD=1
# Show SLAM pass/fail checklist in Live View (also enables AR debug panel):
# VITE_AR_SLAM_DIAG=1
