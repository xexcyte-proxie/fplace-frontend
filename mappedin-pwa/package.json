{
  "name": "fplaces-mappedin-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "prebuild": "npm run copy:ar:public",
    "build": "tsc && vite build",
    "copy:ar:public": "rm -rf public/ar && mkdir -p public/ar && rsync -a --exclude .netlify ../ar-nav/ public/ar/",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/inria-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mappedin/blue-dot": "6.20.0-beta.0",
    "@mappedin/mappedin-js": "6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
